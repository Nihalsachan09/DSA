class Solution {
public:

    int count(vector<int>& coins, int n, int sum,vector<vector<int>>& dp) {

        // Base case
        if (sum == 0) {
            return 1;
        }

        if (sum < 0) {
            return 0;
        }

        if (n <= 0) {
            return 0;
        }
        if (dp[n][sum] != -1)
            return dp[n][sum];

        dp[n][sum]= count(coins, n - 1, sum, dp)
             + count(coins, n, sum - coins[n - 1],dp);
    
        return dp[n][sum];
    
    }

    int change(int amount, vector<int>& coins) {

        int n = coins.size();
        vector<vector<int>> dp(n + 1, vector<int>(amount + 1, -1));

        return count(coins, n, amount,dp);
    }
};
