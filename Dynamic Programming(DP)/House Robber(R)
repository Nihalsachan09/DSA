class Solution {
public:
  
    int solve(vector<int>&nums,int n){

        if(n>=nums.size()){
            return 0;
        }

        int include=solve(nums,n+2)+nums[n];
        int exclude=solve(nums,n+1)+0;

        return max(include,exclude);
    }


    int rob(vector<int>& nums) {

        int n=nums.size();

        int ans=solve(nums,0);

        return ans;
    }
};
