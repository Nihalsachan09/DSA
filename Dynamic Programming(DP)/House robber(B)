class Solution {
public:

    int rob(vector<int>& nums) {

        int n = nums.size();

        if(n == 1) {
            return nums[0];
        }

        vector<int> dp(n, 0);

        // First house
        dp[0] = nums[0];

        // Second house
        dp[1] = max(nums[0], nums[1]);

        // Fill remaining states
        for(int i = 2; i < n; i++) {

            int include = nums[i] + dp[i - 2];

            int exclude = dp[i - 1];

            dp[i] = max(include, exclude);
        }

        return dp[n - 1];
    }
};
