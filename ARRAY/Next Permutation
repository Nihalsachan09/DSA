class Solution {
public:
    void nextPermutation(vector<int>& nums) {

        int n=nums.size();

        int pivot=-1;

        //finding pivot elements
        for(int i=n-2;i>=0;i--){
            if(nums[i]<nums[i+1]){
                pivot=i;
                break;
            }
        }

        //if no pivot,reverse whole array
        if(pivot==-1){
            reverse(nums.begin(),nums.end());
            return;
        }

        //find next larger element and swap
        for(int i=n-1;i>pivot;i--){
            if(nums[i]>nums[pivot]){
                swap(nums[i],nums[pivot]);
                break;
            }
        }

        //reverse from pivot+1 to end(n-1)
        int i=pivot+1,j=n-1;
        while(i<=j){
            swap(nums[i],nums[j]);
            i++;
            j--;
        }
        
    }
};
