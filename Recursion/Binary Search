class Solution {
public:
    int search(vector<int>& nums, int target) {

        int s = 0;
        int e = nums.size() - 1;

        function<int(int, int)> binarySearch = [&](int s, int e) {

            if (s > e) {
                return -1;
            }

            int mid = s + (e - s) / 2;

            if (nums[mid] == target) {
                return mid;
            }

            if (nums[mid] < target) {
                return binarySearch(mid + 1, e);
            }
            else {
                return binarySearch(s, mid - 1);
            }
        };

        return binarySearch(s, e);
    }
};
