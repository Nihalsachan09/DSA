class Solution {
public:
    
    int solve(vector<int>&arr,int l,int r){

        if(l==r){
            return l;
        }

        int mid=l+((r-l)/2);

        if(arr[mid]<arr[mid+1]){
            return solve(arr,mid+1,r);
        }
        else{
            return solve(arr,l,mid);
        }
    }
 
    int peakIndexInMountainArray(vector<int>& arr) {
        return solve(arr,0,arr.size()-1);
        
    }
};
