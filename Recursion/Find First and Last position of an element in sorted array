class Solution {
public:

    int first(vector<int>&a,int l,int r,int x){
        if(l>r){
            return -1;
        }
        int mid=(l+(r-l)/2);

        if(a[mid]==x){
            int p=first(a,l,mid-1,x);
            return p==-1?mid:p;
        }
        if(a[mid]<x){
            return first(a,mid+1,r,x);
        }
        else{
            return first(a,l,mid-1,x);
        }
    }
    int last(vector<int>&a,int l,int r,int x){
        if(l>r){
            return -1;
        }
        int mid=(l+(r-l)/2);

        if(a[mid]==x){
            int p=last(a,mid+1,r,x);
            return p==-1?mid:p;
        }
        if(a[mid]<x){
            return last(a,mid+1,r,x);
        }
        else{
            return last(a,l,mid-1,x);
        }
    }

    
    vector<int> searchRange(vector<int>& nums, int target) {
        
        int n=nums.size();

        return {first(nums,0,n-1,target),last(nums,0,n-1,target)};
        
    }
};
