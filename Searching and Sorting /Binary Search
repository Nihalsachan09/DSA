class Solution {
public:
    
    int binarysearch(vector<int>& nums, int size, int target) {

        int start = 0;
        int end = size - 1;
        int mid = start + (end - start) / 2;

        while (start <= end) {

            if (nums[mid] == target) {
                return mid;
            }

            if (target > nums[mid]) {
                start = mid + 1;
            }
            else {
                end = mid - 1;
            }

            mid = start + (end - start) / 2;
        }

        return -1;
    }

    int search(vector<int>& nums, int target) {

        int size = nums.size();

        return binarysearch(nums, size, target);
    }
};
